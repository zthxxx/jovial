# Slim image for the correctness test suite (layer 1-2): zsh + python3 only.
# Unlike the visual-preview image (Dockerfile), this one carries no vhs / ttyd /
# fonts / language runtimes -- it exists to run the detection tests in a clean
# Linux environment fully isolated from the host shell setup.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        zsh python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8
WORKDIR /repo
