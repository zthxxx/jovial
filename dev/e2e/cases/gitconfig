# Fixed git config for the e2e demo, bind-mounted into the container and used via
# GIT_CONFIG_GLOBAL (see dev/e2e/Dockerfile) -- so the identity is a committed file,
# not generated by setup.zsh. Edits take effect on the next render with no rebuild.
[user]
	email = demo@jovial.theme
	name = jovial
[init]
	defaultBranch = main
